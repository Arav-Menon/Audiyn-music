generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(uuid())
  username  String     @unique
  email     String     @unique
  password  String
  // provider  Provider
  streams   Streams[]
  upvotes   Upvotes[]
  room      Room[]
  roomUser  RoomUser[]
  createdAt DateTime   @default(now())
}

model Streams {
  id           String     @id @default(uuid())
  type         StreamType
  videoId      String
  songName     String
  artistName   String
  thumbnailUrl String
  roomId       String?
  room         Room?      @relation(fields: [roomId], references: [id])
  upvotes      Upvotes[]
  userId       String
  user         User       @relation(fields: [userId], references: [id])

  @@unique([videoId])
}

model Upvotes {
  id      String  @id @default(uuid())
  userId  String
  videoId String
  user    User    @relation(fields: [userId], references: [id])
  Streams Streams @relation(fields: [videoId], references: [id])

  @@unique([userId, videoId])
}

model Room {
  id        String    @id @default(uuid())
  name      String    @unique
  code      String    @unique
  isPrivate Boolean   @default(false)
  password  String?
  adminId   String
  createdBy User      @relation(fields: [adminId], references: [id])
  createdAt DateTime  @default(now())
  streams   Streams[]
}

model RoomUser {
  id           String   @id @default(uuid())
  userId       String
  roomId       String
  user         User     @relation(fields: [userId], references: [id])
  joinedRoomAt DateTime @default(now())

  @@unique([userId, roomId])
}

enum StreamType {
  VIDEO
  SONG
  PLAYLIST
  ARTIST
  ALBUM
}

enum Provider {
  Google
  Spotify
}
