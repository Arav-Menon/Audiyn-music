generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(uuid())
  username  String     @unique
  email     String     @unique
  password  String
  // provider  Provider
  streams   Streams[]
  upvotes   Upvotes[]
  room      Room[]
  roomUser  RoomUser[]
  recentRooms RecentRoom[]
  createdAt DateTime   @default(now())
}

model Streams {
  id           String     @id @default(uuid())
  type         StreamType
  videoId      String
  songName     String
  artistName   String
  thumbnailUrl String
  roomId       String?
  room         Room?      @relation(fields: [roomId], references: [id])
  upvotes      Upvotes[]
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([videoId])
}

model Upvotes {
  id       String  @id @default(uuid())
  userId   String
  videoId  String
  user     User    @relation(fields: [userId], references: [id])
  streamId String
  stream   Streams @relation(fields: [streamId], references: [id]) // Changed from videoId to streamId

  @@unique([userId, videoId], map: "userId_videoId")
}

model Room {
  id        String    @id @default(uuid())
  name      String    @unique
  code      String    @unique
  isPrivate Boolean   @default(false)
  password  String?
  adminId   String
  createdBy User      @relation(fields: [adminId], references: [id])
  createdAt DateTime  @default(now())
  streams   Streams[]
  recentRooms RecentRoom[]
}

model RoomUser {
  id           String   @id @default(uuid())
  userId       String
  roomId       String
  user         User     @relation(fields: [userId], references: [id])
  joinedRoomAt DateTime @default(now())

  @@unique([userId, roomId])
}

model RecentRoom {
  id           String   @id @default(uuid())
  userId       String
  roomId       String
  roomName     String
  roomCode     String
  hostName     String?
  lastJoinedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  room Room @relation(fields: [roomId], references: [id])

  @@unique([userId, roomId])
}

enum StreamType {
  VIDEO
  SONG
  PLAYLIST
  ARTIST
  ALBUM
}

enum Provider {
  Google
  Spotify
}
